# Copy this to .env and fill in only what you use. Everything here is optional.

# Speaker labels per word (--diarize on the transcribe step). Needs a free Hugging Face account and
# accepting the pyannote/speaker-diarization-3.1 model terms. Leave blank for single-speaker footage.
HUGGINGFACE_TOKEN=

# Where the transcriber keeps its own Python environment (built once on first run, reused forever).
# Default: ~/.cache/video-editor/whisperx-venv
VIDEO_EDITOR_WHISPERX_VENV=
