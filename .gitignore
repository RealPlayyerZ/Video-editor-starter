assets/memes/*
!assets/memes/README.md
assets/broll/
.env
.mcp.json
.claude/settings.local.json

# --- machine junk ---
node_modules/
.venv*/
__pycache__/
*.pyc
work/
*.bak*
*:Zone.Identifier
.DS_Store
Thumbs.db
